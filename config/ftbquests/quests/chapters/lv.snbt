		{
			dependencies: ["6AE36CD4F39DAB08"]
			description: [
				"&3Extractors&r are useful for melting things into liquids. For example, you can melt down ingots into molten metals, or &6Rubber Sheets&r into liquid &9Rubber&r."
				""
				"You can make molds from &6Steel&r and use &3Fluid Solidifiers&r to form various components more efficiently from fluids, like &6Gears&r."
			]
			icon: "gtceu:lv_extractor"
