	quests: [
		{
			dependencies: ["74935A3553451178"]
			dependency_requirement: "one_completed"
			description: ["&aMV Batteries&r function essentially the same as &aLV Batteries&r, only stronger. They also need to be put into &3MV Machines, MV Battery Buffers&r or &3MV Turbo Chargers&r."]
			icon: {
