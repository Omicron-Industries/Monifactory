			}]
			x: -8.0d
			y: 0.5d
		}
		{
			dependencies: [
				"0002BA59214CE34A"
				"417D97D9E3562F45"
			]
			description: [
				"&6Transistors&r are semiconductors that can amplify or switch electrical signals and power. They're probably one of the most important inventions of the 20th century."
				""
				"You're going to use them as a component for better circuits. This one is a bit pricey, requiring &2PE, Silicon Plates and Fine Tin Wire."
			]
			icon: "gtceu:transistor"
			id: "13035465E07E34CF"
