		{
			dependencies: [
				"63B27CA5BB60B740"
				"15E34DEC491FAB81"
			]
			dependency_requirement: "one_completed"
			description: [
				"[\"\",{\"text\":\"By this point, the \"},{\"underlined\":\"true\",\"text\":\"Distillation Tower\",\"clickEvent\":{\"action\":\"change_page\",\"value\":\"7641AE777370BE1A\"}},{\"text\":\" should be within reach.\"}]"
				""
				"This enables you to produce all byproducts from &9Oil&r instead of just one."
				""
				"[\"\",{\"text\":\"At this point, you should consider producing \"},{\"color\":\"blue\",\"underlined\":\"true\",\"text\":\"Gasoline\",\"clickEvent\":{\"action\":\"change_page\",\"value\":\"4C76017864258EA9\"}},{\"text\":\" or \"},{\"color\":\"blue\",\"underlined\":\"true\",\"text\":\"Diesel\",\"clickEvent\":{\"action\":\"change_page\",\"value\":\"74EDAE84246C7228\"}},{\"text\":\" if your generators consume too much of your current fuel - they'll last longer than less sophisticated fuels.\"}]"
			]
