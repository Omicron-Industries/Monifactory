		{
			dependencies: ["66FCC26399376B55"]
			description: ["[\"\",{\"text\":\"This pack has \"},{\"color\":\"aqua\",\"text\":\"Inventory Tweaks\"},{\"text\":\", allowing for quick, customizable, and easy sorting of any inventory! The default keybind is \"},{\"color\":\"gold\",\"underlined\":true,\"bold\":1,\"text\":\"\\\\\",\"hoverEvent\":{\"action\":\"show_text\",\"contents\":{\"text\":\"\\\"Sort Player Inventory\\\" in keybind option\"}}},{\"text\":\".\"}]"]
