		{
			dependencies: ["2BF1E9CC0D7F7C91"]
			description: ["Raw Rubber can be &3Centrifuged&r from &6Sticky Resin&r, but if you're not after &9Glue&r or &6Plant Balls&r then the &3Extractor&r is faster."]
			id: "5560E43D1B773B93"
			subtitle: "[\"\",{\"italic\":\"true\",\"text\":\"This step requires a \"},{\"italic\":\"true\",\"bold\":\"true\",\"text\":\"Centrifuge\"},{\"italic\":\"true\",\"text\":\" or \"},{\"italic\":\"true\",\"bold\":\"true\",\"text\":\"Extractor\"},\".\"]"
