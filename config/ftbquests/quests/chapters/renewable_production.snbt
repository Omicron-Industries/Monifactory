			description: ["Smelt your &6Iron Dust&r into &6Iron Ingots&r. You should use the upgraded furnaces from &bIron Furnaces&r or &3Electric Furnaces&r for this. Later, once you unlock them, &3Multi Smelters&r will be the best for this."]
			id: "4EC63681CBC1CAD2"
			optional: true
			subtitle: "[\"\",{\"italic\":\"true\",\"text\":\"This step requires a \"},{\"italic\":\"true\",\"bold\":\"true\",\"text\":\"Furnace\"},{\"italic\":\"true\",\"text\":\" or \"},{\"italic\":\"true\",\"bold\":\"true\",\"text\":\"Electric Furnace\"},\".\"]"
			tasks: [{
				id: "42D25699329E820D"
				item: "minecraft:iron_ingot"
