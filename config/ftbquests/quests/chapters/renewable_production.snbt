			x: -5.0d
			y: -2.5d
		}
		{
			dependencies: [
				"7CFC483280B08A26"
				"7B4EB40F016DBD76"
			]
			description: ["Blast your &6Wrought Iron&r into &6Steel&r. This process yields &6Ashes&r as a byproduct, which can be centrifuged for more byproducts or simply voided.\n\nHow convenient that you can make &6Steel&r just from &6Amethyst&r!"]
			id: "031A5A2B3AA99782"
			optional: true
			size: 2.0d
			subtitle: "[\"\",{\"italic\":\"true\",\"text\":\"This step requires a \"},{\"italic\":\"true\",\"bold\":\"true\",\"text\":\"Electric Blast Furnace\"},{\"italic\":\"true\",\"text\":\" at \"},{\"italic\":\"true\",\"bold\":\"true\",\"text\":\"MV\"},{\"italic\":\"true\",\"text\":\" or higher.\"}]"
			tasks: [{
				id: "5851026225C2E439"
				item: "gtceu:steel_ingot"
				type: "item"
			}]
			x: -3.0d
			y: -5.0d
		}
		{
			dependencies: ["3380CBA4E4010EEC"]
			description: ["Reconstruct your &6Sand&r into &6Soul Sand&r. Aside from the vanilla applications of Bubble Elevators and summoning the &eWither&r, Soul Sand is used to alloy &6Soularium&r and can be centrifuged for resources."]
			id: "1E6CDC008C85D941"
			subtitle: "[\"\",{\"italic\":\"true\",\"text\":\"This step requires a \"},{\"italic\":\"true\",\"bold\":\"true\",\"text\":\"Atomic Reconstructor\"},{\"italic\":\"true\",\"text\":\" at \"},{\"italic\":\"true\",\"bold\":\"true\",\"text\":\"MV\"},{\"italic\":\"true\",\"text\":\" or higher.\"}]"
			tasks: [{
				id: "173EB624F12777AD"
				item: "minecraft:soul_sand"
				type: "item"
			}]
			x: 4.5d
			y: -7.0d
		}
		{
			dependencies: ["1E6CDC008C85D941"]
			description: ["Centrifuge your &6Soul Sand&r to get &6Saltpeter Dust&r, &6Coal Dust&r, &9Oil&r, and some of that original &6Sand&r. This process is quite power-hungry and slow for a main source of these materials, but it'll supplement your other options nicely."]
			id: "1AFB2AD1A572E1D3"
			subtitle: "[\"\",{\"italic\":\"true\",\"text\":\"This step requires a \"},{\"italic\":\"true\",\"bold\":\"true\",\"text\":\"Centrifuge\"},{\"italic\":\"true\",\"text\":\" at \"},{\"italic\":\"true\",\"bold\":\"true\",\"text\":\"MV\"},{\"italic\":\"true\",\"text\":\" or higher.\"}]"
			tasks: [{
				id: "11CDB77540DAC85D"
				item: {
					Count: 1
					id: "itemfilters:or"
					tag: {
						items: [
							{
								Count: 1b
								id: "gtceu:saltpeter_dust"
							}
							{
								Count: 1b
								id: "gtceu:coal_dust"
