				item: "gtceu:plant_ball"
				type: "item"
			}]
			x: 5.0d
			y: 5.0d
		}
		{
			dependencies: ["345470975C5570B7"]
			description: ["&6Plant Balls&r can be smelted into &6Slime Balls&r if you can't find a &eSlime Chunk&r."]
			id: "0C80D39012952549"
			subtitle: "[\"\",{\"italic\":\"true\",\"text\":\"This step requires a \"},{\"italic\":\"true\",\"bold\":\"true\",\"text\":\"Furnace\"},{\"italic\":\"true\",\"text\":\" or \"},{\"italic\":\"true\",\"bold\":\"true\",\"text\":\"Electric Furnace\"},\".\"]"
