		{
			dependencies: ["3E90A188715DA88A"]
			description: ["Smelt your &6Resonant Clathrate&r into &6Pulsating Dust&r. If you're using a &3Furnace&r to smelt it, it's more efficient to use the upgraded &3Furnaces&r, such as &3Iron Furnaces&r. You can fuel them with &6Sugar Cane&r. You might want to keep it as an &3Electric Furnace&r, depending on your circumstances. "]
			id: "2B4F44E19AA7A1B6"
			optional: true
			subtitle: "[\"\",{\"italic\":\"true\",\"text\":\"This step requires a \"},{\"italic\":\"true\",\"bold\":\"true\",\"text\":\"Furnace\"},{\"italic\":\"true\",\"text\":\" or \"},{\"italic\":\"true\",\"bold\":\"true\",\"text\":\"Electric Furnace\"},\".\"]"
