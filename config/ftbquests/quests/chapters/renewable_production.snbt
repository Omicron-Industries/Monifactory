		{
			dependencies: [
				"2AC7A8036CA65AF3"
				"1FEC7E9025F6277A"
			]
			description: ["Although &9Biomass&r can be obtained directly through most types of plant matter, it is more efficient to turn that plant matter into &6Bio Chaff&r before putting it in the &3Brewery&r.\n\nThe &3Pyrolyse Oven&r can be used to make &9Biomass&r from &6Bio Chaff&r with a little more efficiency, but it's significantly slower."]
			icon: "gtceu:biomass_bucket"
			id: "3B1873913255E7C0"
			subtitle: "[\"\",{\"italic\":\"true\",\"text\":\"This step requires a \"},{\"italic\":\"true\",\"bold\":\"true\",\"text\":\"Brewery\"},{\"italic\":\"true\",\"text\":\" or \"},{\"italic\":\"true\",\"bold\":\"true\",\"text\":\"Pyrolyse Oven\"},{\"italic\":\"true\",\"text\":\" at \"},{\"italic\":\"true\",\"bold\":\"true\",\"text\":\"LV\"},{\"italic\":\"true\",\"text\":\" or higher.\"}]"
