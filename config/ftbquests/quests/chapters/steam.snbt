		{
			dependencies: [
				"59878F76EE175FA9"
				"4CBC4C49065BD832"
			]
			dependency_requirement: "one_completed"
			description: [
				"&9This is where &bEMI&9 really shines! Using it alongside &3Crafting Stations&9, you should be able to easily calculate the amount of raw resources and intermediate components you'll need to &ebatch craft &9electronic circuits quickly."
				""
				"You'll be making a LOT&r of circuits, so take advantage of the improved crafting efficiency."
			]
			icon: "gtceu:basic_electronic_circuit"
			id: "4A5CC6210FCEC075"
			rewards: [{
				id: "7FA29F2B00C3D7B1"
