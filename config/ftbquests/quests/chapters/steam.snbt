					}
				}
				type: "item"
			}]
			size: 1.25d
			subtitle: "Don't be a hoarder!"
			tasks: [
				{
					id: "1D2F282EA1341251"
					type: "checkmark"
				}
				{
					disable_toast: true
					id: "6A9840696B48DDD0"
					item: {
						Count: 1
						id: "itemfilters:tag"
						tag: {
							value: "moni:coins"
						}
					}
					optional_task: true
					title: "Monicoins"
