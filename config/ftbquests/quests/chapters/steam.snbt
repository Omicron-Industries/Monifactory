		{
			dependencies: ["7457A13C74667E40"]
			dependency_requirement: "one_completed"
			description: [
				"&9Sneak-right-click a Multiblock controller with a terminal to have it automatically pull blocks from your inventory to build the multiblock."
				""
				"It is important to note that if you do not have the required hatches, the Terminal will leave holes for those hatches, leaving the multiblock unformed."
			]
			disable_toast: true
			icon: "gtceu:terminal"
			id: "5D05C9E09637231C"
			rewards: [{
				id: "6542896D57F56AB1"
