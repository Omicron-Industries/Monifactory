		{
			dependencies: [
				"64ABEB1EF9F81EA4"
				"18F01BB67968C209"
			]
			description: ["You might want to save your &6Coal Dust&r for circuits and use &6Charcoal Dust&r instead. Later, you can also process either &6Coal Coke Dust&r or &2Diamond Dust&r into &6Carbon Dust&r, which can be used for other alloys."]
			hide_until_deps_visible: true
