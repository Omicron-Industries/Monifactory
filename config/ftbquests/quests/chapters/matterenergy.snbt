			description: [
				"It's a micropart, so you need to place it on an &6ME Cable&r."
				""
				"When encoding Processing Patterns, note the scrollbar on the left - you can encode up to 81 types of items and fluids!"
			]
			id: "480EE330E12084E8"
			rewards: [{
				id: "26AC32A839C6603B"
				item: "kubejs:moni_nickel"
				type: "item"
			}]
			shape: "hexagon"
