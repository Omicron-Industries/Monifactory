		}
		{
			dependencies: [
				"417D97D9E3562F45"
				"6169C04DF463502F"
			]
			description: [
				"Encode them in a &aPattern Encoding Terminal&r."
				""
				"Note that recipes encoded with Substitutions on will use existing equivalent items, but &ewill only automatically craft the exact item specified in the recipe.&r"
				""
				"&2Don't encode recipes that use hand tools.&r Otherwise, you risk jamming your system due to durability or NBT mismatches."
				""
				"Use recipes that use machines instead!"
			]
			id: "6F32A8739D8E792A"
			rewards: [{
				id: "23AA5139279F5F80"
				item: "kubejs:moni_nickel"
				type: "item"
			}]
			shape: "hexagon"
			size: 2.0d
			subtitle: "&aPatterns&r are used to encode a single crafting table or processing recipe for on-demand automation with &bApplied Energistics&r."
			tasks: [{
				id: "384964EBBD93B59C"
				item: "ae2:blank_pattern"
