		{
			dependencies: ["21B16C005E9E3B0E"]
			description: [
				"&2Gasoline is a powerful combustion fuel, generating 1600 EU per mB of fluid. It can also be substituted for Cetane-Boosted Diesel in Cryolobus production."
				""
				"Gasoline is made of:"
				"- 16 parts Naphtha"
				"- 2 parts Refinery Gas"
				"- 2 parts Toluene"
				"- 1 part Methanol"
				"- 1 part Acetone"
				""
				"To get the most out of this, run it in an Extreme Combustion Engine with Liquid Oxygen."
			]
			icon: "gtceu:gasoline_bucket"
