	quests: [
		{
			dependencies: [
				"77582C534A994D7C"
				"7E09D4E00BFA4970"
				"386DB3C9E646764D"
			]
			description: [
				"The &3Advanced Microverse Projector&r is a more powerful projector required for sending &6Tier Four&r through &6Tier Six Microminers&r into microverses."
				""
				"Additionally, for each tier of projector you use above the required tier of a recipe, you will get a free perfect overclock, similar to how &3EBF&rs grant perfect overclocks with temperature."
				""
				"This tier requires &6EV Field Generators&r, and therefore &6Uranium&r. You can get some from processing &6Uraninite&r."
				""
				"Initial missions can operate on &eIV power&r, while &eLuV power&r is required for later missions. As with the prior projector, this structure supports overclocking and the position of buses and hatches can be swapped with any &6Microverse Projector Casing&r."
				""
				"&6Sneak-right click&r the controller to enable the in-world preview."
			]
			icon: "monilabs:advanced_microverse_projector"
